# Артефакт индекса codebase-memory-mcp (локальный, генерируется при индексации)
.codebase-memory/

# Python
__pycache__/
*.py[cod]

# Окружение и кэш сборок
.venv/
.ruff_cache/
.pytest_cache/
build/
dist/
*.spec

# Логи приложения
logs/
*.log

# Регрессионные отчёты tools/regress.py: эталон (tools/baseline.json) в git,
# сравнительные прогоны (tools/after.json и подобные) — нет
tools/after*.json
tools/before*.json
*_regress_*.json

# Сборки .exe
*.exe

# НАСТОЯЩИЕ выгрузки 1С.
# Это бухгалтерские данные компаний, в репозитории им не место. Папки с
# выгрузками держать ВНЕ проекта; правила ниже — страховка на случай, если
# папка всё-таки окажется внутри и кто-то выполнит git add .
_dumps/
_regress_dumps/
_1C/
_выгрузки/
test_dumps/

# Любой .xlsx под контролем версий. Исключения невозможны: папок с
# закоммиченными таблицами в проекте нет, а синтетические фикстуры тестов
# собираются кодом и на диск не попадают.
*.xlsx
*.xls
*.xlsm