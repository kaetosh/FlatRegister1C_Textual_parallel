Screen {
    align: center middle;
    layout: vertical;
    height: 100%;
}

.bottom-bar {
    height: auto;
    min-height: 3;
}


#markdown_start {
   /* column-span: 2;*/

    border: solid #0087d7;
    height: 1fr;
    overflow-y: auto;
}

#select_register {
    width: 60%;
}

#continue {
    width: 60%;
}

#left_select {
    align: right middle;
}

#right_button {
    align: left middle;
}

#register_requirements {
    height: 1fr;
    overflow-y: auto;
}

#horizontal_input {
   /* height: 15%;*/
    padding: 1;
}

#horizontal_select_register {
    padding: 1;
}

#result_processing {
    height: 1fr;
    overflow-y: auto;
}

#failed_files_log_hint {
    height: auto;
    padding: 1 2;
    color: $text-muted;
    border-top: solid $panel;
}

#screen_progress_bar {
    align: center middle;
    height: 25%;
    width: 50%;
    border: round orange;
}

#label_progress {
    text-align: center;
    width: 100%;
    height: 75%;
}

ProgressBar {
    align: center middle;
    width: 100%;
}

SettingsScreenRegister {
        align: center middle;
    }
        #container-settings-screen-modal {
            width: 70%;
            height: 70%;
            margin: 1 1;
            padding: 1 1;
            border: round orange;
            layout: vertical;
        }

        #static-settings-register-modal {
            height: auto;
            margin-bottom: 1;
            content-align: center middle;
        }

        #scrollable-selection-list {
            overflow-y: auto;
            height: 1fr;
            overflow-y: auto;
        }

        #selection-list-settings-modal {
            width: 100%;
        }

        #static_help-settings-modal {
            text-style: italic;
            height: auto;
            margin: 1 0;
        }

        #horizontals-button-settings-register-modal {
            height: auto;
            align: center middle;
            margin-top: 1;
        }
        .buttons-settings-modal {
            margin: 0 1;
        }
        #button-save-settings-modal,
        #button-cancel-settings-modal {
            width: 45%;
        }

SettingsScreen {
        align: center middle;
    }
        #container-settings-modal {
           width: 50%;
           height: 50%;
           margin: 1 1;
           padding: 1 1;
           border: round orange;
           layout: vertical;
        }
       .statics-settings-modal {
          content-align: left middle;
          height: 3;
          width: 80%;
       }
       .switchs-settings-modal {
           content-align: right middle;
           width: 20%;
       }
       #statics-no-turnover-settings-modal {
           text-style: italic;
           text-align: center;
       }
       #horizontals-button-settings-modal{
           align: center bottom;
           }
       #button-settings-modal,
       #button-settings-cancel-modal {
            width: 45%;
        }

ContactsScreen {
    background: $surface;

    #info_text {
        text-align: center;
        margin: 1 1;
        padding: 1;
        width: 100%;
    }

    .flex-row {
        layout: horizontal;
        align: center middle;
        margin: 1 1;
        padding: 1;
        height: auto;
        width: 100%;
    }

    .selector-container {
        width: 30%;
        align: center middle;
        padding: 0;
    }

    .selector-label {
        text-align: center;
        text-style: bold;
        margin-bottom: 1;
    }

    #messenger_selector {
        width: 100%;
        margin: 0;
    }

    .qr-container {
        width: 65%;
        align: center middle;
        padding: 0;
        border-title-align: center;
    }

    .qr-label {
        text-align: center;
        text-style: bold;
        margin-bottom: 1;
    }

    #qr_code {
        text-align: center;
        margin: 0;
        padding: 1;
        width: 100%;
        height: auto;
        background: $surface;
    }
}

.hint {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    height: auto;
    padding: 0 1;
}

.warning {
    text-align: center;
    color: $error;
    text-style: bold;
    height: auto;
    padding: 0 1;
}
